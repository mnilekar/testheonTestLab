---
import StoreShell from '../../../../components/StoreShell.astro';
---

<StoreShell
  title="Order confirmation"
  description="A deterministic confirmation screen with a synthetic order ID."
  canonicalPath="/apps/ecommerce/confirmation/"
  page="cart"
>
  <section class="store-page section">
    <div
      class="container store-confirmation"
      id="store-confirmation"
      aria-live="polite"
    >
      <p class="eyebrow">Fake order confirmation</p>
      <h1>Checking your practice order…</h1>
    </div>
  </section>
</StoreShell>
