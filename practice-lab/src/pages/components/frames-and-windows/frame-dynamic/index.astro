---
import {
  resolveDeployTarget,
  resolveRobotsPolicy,
} from '../../../../config/site';

const robots = resolveRobotsPolicy(
  'noindex,follow',
  resolveDeployTarget(import.meta.env.PUBLIC_DEPLOY_TARGET),
  import.meta.env.PUBLIC_ROBOTS_POLICY,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content={robots} />
    <title>Dynamically loaded frame</title>
    <style>
      body {
        margin: 0;
        padding: 1rem;
        color: #241f35;
        background: #fff4f8;
        font:
          1rem/1.5 Inter,
          system-ui,
          sans-serif;
      }
    </style>
  </head>
  <body>
    <strong>Dynamically loaded frame</strong>
    <p data-testid="dynamic-frame-ready">Dynamic frame ready.</p>
  </body>
</html>
