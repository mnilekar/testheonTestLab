---
const title = 'Nested parent frame';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
    <style>
      body {
        margin: 0;
        padding: 0.75rem;
        color: #241f35;
        background: #eef5ff;
        font:
          1rem/1.5 Inter,
          system-ui,
          sans-serif;
      }
      iframe {
        width: 100%;
        min-height: 7rem;
        border: 2px solid #5b35b5;
        border-radius: 0.5rem;
      }
    </style>
  </head>
  <body>
    <strong>Nested parent frame</strong>
    <iframe
      title="Nested child frame"
      src="/practice/components/frames-and-windows/frame-child/"
    ></iframe>
  </body>
</html>
