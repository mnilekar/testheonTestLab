---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'quiet';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  analyticsEvent?: string;
  analyticsContent?: string;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  class: className = '',
  analyticsEvent,
  analyticsContent,
} = Astro.props;
const classes = ['button', `button--${variant}`, className]
  .filter(Boolean)
  .join(' ');
---

{href ? (
  <a
    class={classes}
    href={href}
    data-analytics-event={analyticsEvent}
    data-analytics-content={analyticsContent}
  >
    <slot />
  </a>
) : (
  <button
    class={classes}
    type={type}
    data-analytics-event={analyticsEvent}
    data-analytics-content={analyticsContent}
  >
    <slot />
  </button>
)}
