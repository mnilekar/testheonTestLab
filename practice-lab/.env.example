# Public build configuration. These values are not secrets.
PUBLIC_SITE_ORIGIN=https://testheon.com
PUBLIC_ROBOTS_POLICY=index,follow
PUBLIC_DEPLOY_TARGET=local

# Staging release configuration. Keep real values in an uncommitted .env file or CI secret store.
PRACTICE_LAB_STAGING_ORIGIN=https://practice-staging.testheon.com
PRACTICE_LAB_STAGING_AUTH_CONFIRMED=false
PRACTICE_LAB_STAGING_HTTP_USER=
PRACTICE_LAB_STAGING_HTTP_PASSWORD=
PRACTICE_LAB_RELEASE_CONTROL_TOKEN=

# Short-lived Hostinger File Browser upload credentials. Supply these only for a deployment
# in an ignored .deploy.env file, then delete that file immediately after use.
PRACTICE_LAB_STAGING_UPLOAD_URL=
PRACTICE_LAB_STAGING_UPLOAD_AUTH_KEY=
PRACTICE_LAB_STAGING_UPLOAD_REST_AUTH_KEY=

# Production release configuration. Keep real values in an uncommitted .env file or CI secret store.
# The production uploader is restricted by the deploy script to public_html/practice only.
PRACTICE_LAB_PRODUCTION_ORIGIN=https://testheon.com
PRACTICE_LAB_PRODUCTION_RELEASE_CONTROL_TOKEN=

# Short-lived Hostinger File Browser credentials, supplied only through ignored .deploy.env.
PRACTICE_LAB_PRODUCTION_UPLOAD_URL=
PRACTICE_LAB_PRODUCTION_UPLOAD_AUTH_KEY=
PRACTICE_LAB_PRODUCTION_UPLOAD_REST_AUTH_KEY=

# Live staging validation. API tests use the protected staging origin and review credentials above.
PRACTICE_LAB_API_BASE_URL=
PRACTICE_LAB_EXPECTED_CANONICAL_ORIGIN=
PRACTICE_LAB_EXPECTED_ROBOTS=
