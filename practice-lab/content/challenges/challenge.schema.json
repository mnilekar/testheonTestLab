{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testheon.com/practice/schemas/challenges.json",
  "title": "Testheon Practice Lab challenge catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogueVersion", "updatedAt", "challenges"],
  "properties": {
    "catalogueVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "updatedAt": { "type": "string", "format": "date" },
    "challenges": {
      "type": "array",
      "minItems": 25,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/challenge" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title",
        "difficulty",
        "skills",
        "technology",
        "feature",
        "application",
        "scenario",
        "objective",
        "preconditions",
        "testData",
        "expectedResult",
        "hints",
        "relatedGuide",
        "relatedFixtures",
        "solutionApproach",
        "estimatedMinutes",
        "version"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^PW-[A-Z0-9]+-[0-9]{3}$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "difficulty": {
          "enum": ["Beginner", "Intermediate", "Advanced", "Expert"]
        },
        "skills": { "$ref": "#/$defs/stringList" },
        "technology": { "const": "Playwright" },
        "feature": { "$ref": "#/$defs/nonEmptyString" },
        "application": { "$ref": "#/$defs/nonEmptyString" },
        "scenario": { "$ref": "#/$defs/nonEmptyString" },
        "objective": { "$ref": "#/$defs/nonEmptyString" },
        "preconditions": { "$ref": "#/$defs/stringList" },
        "testData": { "$ref": "#/$defs/stringList" },
        "expectedResult": { "$ref": "#/$defs/nonEmptyString" },
        "hints": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "relatedGuide": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "url"],
          "properties": {
            "title": { "$ref": "#/$defs/nonEmptyString" },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://testheon\\.com/"
            }
          }
        },
        "relatedFixtures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^FX-[A-Z0-9]+-[0-9]{3}$" }
        },
        "starterCode": { "$ref": "#/$defs/nonEmptyString" },
        "solutionApproach": { "$ref": "#/$defs/stringList" },
        "solutionCode": { "$ref": "#/$defs/nonEmptyString" },
        "estimatedMinutes": { "type": "integer", "minimum": 5, "maximum": 180 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    }
  }
}
