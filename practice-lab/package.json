{
  "name": "@testheon/practice-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "fonts:sync": "node scripts/sync-font-assets.mjs",
    "dev": "pnpm fonts:sync && cross-env NAPI_RS_FORCE_WASI=1 ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "pnpm fonts:sync && pnpm testcases:generate && pnpm challenges:generate && pnpm challenges:validate && pnpm downloads:build && pnpm manifest:validate && cross-env NAPI_RS_FORCE_WASI=1 ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/postbuild.mjs && pnpm seo:audit",
    "build:staging": "node scripts/build-target.mjs staging",
    "preview": "node scripts/serve-dist.mjs",
    "lint": "cross-env NAPI_RS_FORCE_WASI=1 ASTRO_TELEMETRY_DISABLED=1 eslint . --max-warnings=0",
    "format": "cross-env NAPI_RS_FORCE_WASI=1 ASTRO_TELEMETRY_DISABLED=1 prettier --check .",
    "format:write": "cross-env NAPI_RS_FORCE_WASI=1 ASTRO_TELEMETRY_DISABLED=1 prettier --write .",
    "typecheck": "cross-env NAPI_RS_FORCE_WASI=1 ASTRO_TELEMETRY_DISABLED=1 astro check",
    "unit": "vitest run tests/unit tests/integration",
    "e2e": "playwright test",
    "e2e:cross-browser": "playwright test -c playwright.cross-browser.config.ts",
    "api:generate": "node api/seed/generate-seed.mjs && node scripts/generate-openapi.mjs",
    "api:validate": "node scripts/validate-api-artifacts.mjs",
    "testcases:generate": "node scripts/generate-ecommerce-test-cases.mjs",
    "api:test:staging": "playwright test -c playwright.api.config.ts",
    "ui:test:staging": "playwright test -c playwright.ui.config.ts",
    "manifest:validate": "node scripts/validate-manifest.ts",
    "fixtures:contract": "node scripts/verify-fixture-contract.mjs",
    "fixtures:lock": "node scripts/update-fixture-contract-lock.mjs",
    "audit:js": "node scripts/audit-js-budget.mjs",
    "audit:security": "node scripts/audit-build-security.mjs",
    "audit:lighthouse": "node scripts/run-lighthouse.mjs",
    "deploy:staging": "node --env-file-if-exists=.env --env-file-if-exists=.deploy.env scripts/deploy.mjs deploy --target staging",
    "rollback:staging": "node --env-file-if-exists=.env scripts/deploy.mjs rollback --target staging",
    "deploy:production": "node scripts/deploy.mjs deploy --target production",
    "verify": "pnpm lint && pnpm format && pnpm typecheck && pnpm unit && pnpm api:validate && pnpm fixtures:contract && pnpm build && pnpm audit:js && pnpm audit:security && pnpm e2e && pnpm e2e:cross-browser && pnpm manifest:validate",
    "activate:staging": "node --env-file-if-exists=.env scripts/deploy.mjs activate --target staging",
    "status:staging": "node --env-file-if-exists=.env scripts/deploy.mjs status --target staging",
    "staging:credentials": "node scripts/create-staging-credentials.mjs",
    "challenges:generate": "node scripts/generate-challenges.mjs",
    "challenges:validate": "node scripts/validate-challenges.mjs",
    "downloads:build": "node scripts/build-downloads.mjs",
    "seo:audit": "node scripts/audit-seo.mjs",
    "seo:report": "node scripts/report-seo.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "astro": "7.3.5",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/compiler-binding-wasm32-wasi": "0.5.1",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "ajv": "8.20.0",
    "chrome-launcher": "^1.2.2",
    "cross-env": "10.1.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.12.0",
    "lighthouse": "^13.5.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
